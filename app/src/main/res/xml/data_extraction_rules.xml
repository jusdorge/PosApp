<?xml version="1.0" encoding="utf-8"?><!--
   قواعد النسخ الاحتياطي لتطبيق نقطة البيع
   تحديد البيانات التي يتم نسخها احتياطياً على السحابة وعند نقل الجهاز
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- تضمين بيانات المستخدم والعملاء والمنتجات -->
        <include domain="sharedpref" path="user_session"/>
        <include domain="sharedpref" path="app_settings"/>
        <include domain="database" path="customers.db"/>
        <include domain="database" path="products.db"/>
        <include domain="database" path="invoices.db"/>
        <include domain="file" path="exports/"/>
        <include domain="file" path="invoice_images/"/>
        
        <!-- استبعاد البيانات الحساسة والملفات المؤقتة -->
        <exclude domain="sharedpref" path="firebase_auth"/>
        <exclude domain="sharedpref" path="google_signin"/>
        <exclude domain="file" path="cache/"/>
        <exclude domain="file" path="temp/"/>
        <exclude domain="file" path="logs/"/>
        <exclude domain="database" path="temp_data.db"/>
    </cloud-backup>
    
    <device-transfer>
        <!-- نقل البيانات الأساسية فقط عند تغيير الجهاز -->
        <include domain="sharedpref" path="app_settings"/>
        <include domain="database" path="customers.db"/>
        <include domain="database" path="products.db"/>
        <include domain="file" path="exports/"/>
        
        <!-- استبعاد بيانات المصادقة والملفات المؤقتة -->
        <exclude domain="sharedpref" path="user_session"/>
        <exclude domain="sharedpref" path="firebase_auth"/>
        <exclude domain="sharedpref" path="google_signin"/>
        <exclude domain="file" path="cache/"/>
        <exclude domain="file" path="temp/"/>
        <exclude domain="file" path="logs/"/>
        <exclude domain="file" path="invoice_images/"/>
        <exclude domain="database" path="temp_data.db"/>
    </device-transfer>
</data-extraction-rules>