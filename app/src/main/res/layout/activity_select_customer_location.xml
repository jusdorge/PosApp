<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/button_container" />

    <!-- إدخال الإحداثيات يدوياً -->
    <LinearLayout
        android:id="@+id/manual_input_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/button_container"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:elevation="6dp"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/lat_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="خط العرض (lat)"
                android:inputType="numberDecimal|numberSigned"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/lng_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="خط الطول (lng)"
                android:inputType="numberDecimal|numberSigned" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_apply_coordinates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تعيين الإحداثيات على الخريطة"
            android:layout_marginTop="8dp"
            android:background="@color/colorAccent"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <!-- حاوية الأزرار في الأسفل -->
    <LinearLayout
        android:id="@+id/button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="@android:color/white"
        android:elevation="8dp"
        android:padding="16dp"
        android:gravity="center">

        <Button
            android:id="@+id/btn_my_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@color/colorAccent"
            android:drawableTop="@drawable/ic_my_location"
            android:drawableTint="@android:color/white"
            android:padding="12dp"
            android:text="@string/my_location"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btn_save_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@color/colorAccent"
            android:drawableTop="@drawable/ic_save"
            android:drawableTint="@android:color/white"
            android:padding="12dp"
            android:text="@string/saveLocation"
            android:textColor="@android:color/white"
            android:visibility="visible" />

    </LinearLayout>

</RelativeLayout>