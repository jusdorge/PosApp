<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- العنوان -->
    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/edit_payment_method"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/colorPrimary"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- الطريقة الحالية -->
    <TextView
        android:id="@+id/currentMethodTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/current_method_label"
        android:textSize="16sp"
        android:textColor="@color/colorText"
        android:background="@color/colorBackground"
        android:padding="12dp"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- عنوان الخيارات -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/select_new_method"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/colorText"
        android:layout_marginBottom="12dp" />

    <!-- ScrollView لطرق الدفع -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="300dp">

        <RadioGroup
            android:id="@+id/paymentMethodRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- سيتم إضافة RadioButtons برمجياً -->

        </RadioGroup>

    </ScrollView>

    <!-- معلومات إضافية -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/edit_payment_note"
        android:textSize="12sp"
        android:textColor="@color/colorSecondaryText"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:padding="8dp"
        android:background="@color/reportBackgroundLight" />

</LinearLayout> 