<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/invoiceTimeTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:30 AM"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/invoiceIdTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/invoice_number"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/invoiceStatusTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/invoice_status_paid"
                android:textColor="@color/colorPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#E0E0E0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/customerNameTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/customer_name"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/customer_label"
                android:textSize="16sp" />


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <TextView
                android:id="@+id/customerPhoneTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/phone"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/phone_label"
                android:textSize="16sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">
            <TextView
                android:id="@+id/invoiceTotalTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="150.00 دج"
                android:textColor="@color/colorPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/total_amount_label"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text ="                           "
                android:textSize="14sp" />
            <TextView
                android:id="@+id/invoiceItemsCountTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 منتجات"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- أزرار العمليات -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#E0E0E0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="4dp">

            <!-- زر الطباعة -->
            <Button
                android:id="@+id/printInvoiceButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:background="@drawable/button_border"
                android:text="🖨️"
                android:textColor="@color/colorPrimary"
                android:textSize="16sp"
                android:padding="4dp" />

            <!-- زر تحميل في الكاونتر -->
            <Button
                android:id="@+id/loadInCounterButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/button_border"
                android:text="📥"
                android:textColor="@color/colorPrimary"
                android:textSize="16sp"
                android:padding="4dp" />

            <!-- زر إضافة منتجات -->
            <Button
                android:id="@+id/addProductsButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/button_border"
                android:text="➕"
                android:textColor="@color/colorPrimary"
                android:textSize="16sp"
                android:padding="4dp" />

            <!-- زر موقع العميل -->
            <Button
                android:id="@+id/customerLocationButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/button_border"
                android:text="📍"
                android:textColor="@color/colorPrimary"
                android:textSize="16sp"
                android:padding="4dp" />

            <!-- زر الحذف -->
            <Button
                android:id="@+id/deleteInvoiceButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:background="@drawable/button_border"
                android:text="🗑️"
                android:textColor="@color/reportDanger"
                android:textSize="16sp"
                android:padding="4dp" />

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView> 