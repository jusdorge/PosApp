<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- الهيدر: نوع العملية والوقت -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/operationTypeTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/create_invoice_operation"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary" />

            <TextView
                android:id="@+id/operationTimeTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:30"
                android:textSize="12sp"
                android:textColor="@color/colorTextSecondary"
                android:background="@drawable/search_background"
                android:padding="4dp" />

        </LinearLayout>

        <!-- الوصف -->
        <TextView
            android:id="@+id/operationDescriptionTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/create_invoice_description"
            android:textSize="14sp"
            android:textColor="@color/colorText"
            android:layout_marginBottom="8dp" />

        <!-- تفاصيل إضافية -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/userNameTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/example_customer_name"
                android:textSize="12sp"
                android:textColor="@color/colorTextSecondary"
                android:drawablePadding="4dp" />

            <TextView
                android:id="@+id/entityTypeTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/invoice_hash"
                android:textSize="12sp"
                android:textColor="@color/colorTextSecondary"
                android:background="@drawable/search_background"
                android:padding="4dp"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- خط فاصل للعمليات الحساسة -->
        <View
            android:id="@+id/criticalIndicator"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="8dp"
            android:background="@color/reportDanger"
            android:visibility="gone" />

    </LinearLayout>

</androidx.cardview.widget.CardView>